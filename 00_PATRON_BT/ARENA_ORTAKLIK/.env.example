# BATUPIA — Gizli Değerler Şablonu
# Bu dosyayı kopyala:  cp .env.example .env
# .env dosyası GITIGNORE'ludur, GitHub'a ASLA gitmez.

# GitHub kişisel erişim token'ı (yalnızca 'repo' kapsamı önerilir)
GITHUB_TOKEN=

# Stüdyo ana deposu (PATRON BT, mühürler, görseller, belgeler)
GIT_REPO_URL=https://github.com/stonebreaking/batupia-stonebreaking.git

# Canlı oyun sitesi deposu (GitHub Pages — v154 düzeltmesi buraya gider)
GIT_REPO_LIVE_URL=https://github.com/stonebreaking/stonebreaking.github.io.git
